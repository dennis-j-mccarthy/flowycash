generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id         String   @id @default(cuid())
  userId     String   @default("default")
  name       String
  amount     Float
  type       String   // "income" or "expense"
  recurrence String   @default("none") // none, weekly, biweekly, monthly, yearly
  startDate  String   // YYYY-MM-DD
  endDate    String?  // YYYY-MM-DD; if set, no occurrences generated after this date
  autopay    Boolean  @default(false)
  reminder   Boolean  @default(false) // push notification at 9am ET on each occurrence date
  tags       String   @default("")  // comma-separated tags
  highlight  String   @default("")  // color highlight: "", "red", "orange", "yellow", "green", "blue", "purple"
  note       String   @default("")  // user annotation
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  overrides Override[]

  @@index([userId])
}

model Override {
  id             String  @id @default(cuid())
  transactionId  String
  occurrenceDate String  // The original occurrence date YYYY-MM-DD
  name           String?
  amount         Float?
  type           String?
  deleted        Boolean @default(false)
  movedTo        String? // New date if moved YYYY-MM-DD

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, occurrenceDate])
}

model BalanceReset {
  id     String @id @default(cuid())
  userId String @default("default")
  date   String // YYYY-MM-DD
  amount Float

  @@unique([userId, date])
  @@index([userId])
}

model Settings {
  id              String @id @default("default")
  userId          String @default("default")
  startingBalance Float  @default(0)

  @@unique([userId])
}

model SharedAccess {
  id          String @id @default(cuid())
  ownerUserId String // the user who owns the data
  sharedEmail String // email of the person who can view
  createdAt   DateTime @default(now())

  @@unique([ownerUserId, sharedEmail])
  @@index([sharedEmail])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model ReminderLog {
  id            String   @id @default(cuid())
  transactionId String
  date          String   // occurrence date YYYY-MM-DD
  sentAt        DateTime @default(now())

  @@unique([transactionId, date])
}

model MonthNote {
  id     String @id @default(cuid())
  userId String @default("default")
  month  String // YYYY-MM
  note   String @default("")

  @@unique([userId, month])
  @@index([userId])
}

// ───────── CREATOR PAGE (/admin) ─────────
// Ported from built-with-ai; models copied verbatim. Additive only.
// ───────── BLOG POSTS ─────────
// Generated by /admin/blog (source "generated") or typed in by hand
// (source "manual"). Published rows are merged with content/blog/*.md on the
// public blog; a DB row wins when both share a slug.
model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String    @default("")
  /// Markdown body (no frontmatter)
  body        String
  heroImage   String?
  /// Attribution for a stock hero ("Image by X on Pixabay"); shown under it
  heroCredit  String?
  tags        String[]  @default([])
  status      String    @default("draft") // draft | published
  source      String    @default("generated") // generated | manual
  /// Content pillar id (src/lib/pillars.ts) — the brand message it carries
  pillarId    String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  social      SocialDraft[]

  @@index([status, publishedAt])
}

// ───────── SOCIAL DRAFTS / QUEUE ─────────
// One row per platform per post, auto-generated when a BlogPost is published
// (src/lib/publishHooks.ts). The same row doubles as the queue entry: when
// the composer publishes or schedules it through Meta, the result is written
// back (status, metaPostId, scheduledAt, error). Standalone composer posts
// (no blogPostId) are recorded here too so the Queue shows everything.
model SocialDraft {
  id          String    @id @default(cuid())
  blogPost    BlogPost? @relation(fields: [blogPostId], references: [id], onDelete: SetNull)
  blogPostId  String?
  platform    String // facebook | instagram | linkedin | x
  caption     String
  imageUrl    String?
  status      String    @default("draft") // draft | scheduled | published | failed
  /// Content pillar id (src/lib/pillars.ts); inherited from the blog post or chosen in the maker
  pillarId    String?
  scheduledAt DateTime?
  publishedAt DateTime?
  metaPostId  String?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([blogPostId, platform])
  @@index([status, scheduledAt])
  @@index([platform, status])
}

// ───────── UPLOADED IMAGES ─────────
// The picker's Upload tab. Bytes live in Postgres (bytea) — no Blob store —
// and are served publicly from /api/images/[id] (immutable, CDN-cached).
// That absolute URL is what lands in BlogPost.heroImage / SocialDraft.imageUrl,
// so Meta can fetch it. Capped at 4 MB per file by the upload route.
model UploadedImage {
  id        String   @id @default(cuid())
  data      Bytes
  mime      String // image/jpeg | image/png | image/webp
  size      Int
  width     Int?
  height    Int?
  filename  String
  /// Library metadata (migration 0006_library). `title` is shown on the card
  /// (backfilled from `{collection}__{slug}.jpg` workbook filenames);
  /// `collection` groups the grid; `pillarId` ties an image to a brand
  /// message so the post maker can offer the right ones; `credit` is the
  /// attribution line for stock imports; `source` is upload | stock | workbook.
  title      String?
  collection String?
  tags       String[] @default([])
  pillarId   String?
  credit     String?
  source     String   @default("upload")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([collection])
  @@index([pillarId])
}

// ───────── CONTENT PILLARS ─────────
// The brand messages every post / draft / image carries one of. Edited on
// /admin/essence; read by every generator through src/lib/pillarStore.ts
// (loadPillars). `id` is the slug stored on BlogPost.pillarId,
// SocialDraft.pillarId and UploadedImage.pillarId. Migration 0006 seeds the
// four from src/lib/pillars.ts; without a database those defaults apply.
model Pillar {
  id        String   @id
  name      String
  /// One line: the brand message this pillar carries
  message   String
  /// Angle prompts — starting points for a title or a caption
  angles    String[] @default([])
  /// Default hashtags (Instagram mainly)
  hashtags  String[] @default([])
  /// Target share of the content mix, in percent
  target    Int?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

// ───────── BLOG SETTINGS (singleton) ─────────
// id = "default". `tone` holds the BlogTone JSON used by the generator and
// the social-draft writer; the admin UI falls back to localStorage without a DB.
model BlogSettings {
  id        String   @id @default("default")
  tone      Json
  updatedAt DateTime @updatedAt
}

// ───────── BRAND ESSENCE (singleton) ─────────
// id = "default". The Throughline "Essence": the one line, purpose, promise,
// do / don't lists, three voice sliders (0–100) and the tone brief that used
// to live in BlogSettings.tone. Every generator reads it through
// src/lib/brandContext.ts; without a row (or a DB) the code defaults in
// src/lib/pillars.ts apply. Migration 0005 seeds the row from BlogSettings.
model BrandEssence {
  id           String   @id @default("default")
  line         String   @default("")
  purpose      String   @default("")
  promise      String   @default("")
  doList       String[] @default([])
  dontList     String[] @default([])
  /// 0 = serious … 100 = playful
  voicePlayful Int      @default(50)
  /// 0 = casual … 100 = formal
  voiceFormal  Int      @default(50)
  /// 0 = gentle … 100 = bold
  voiceBold    Int      @default(50)
  /// BlogTone JSON (voice / audience / style / dos / donts)
  tone         Json?
  updatedAt    DateTime @updatedAt
}

// ───────── EMAIL DRAFTS ─────────
// Newsletters written by /admin/email from 1–3 published posts. Both
// renderings are stored (html + text). No ESP is wired: status is tracked by
// hand (proposed → ready → sent) and the HTML is copied/downloaded.
model EmailDraft {
  id        String   @id @default(cuid())
  name      String
  subject   String
  preheader String   @default("")
  html      String
  text      String
  pillarId  String?
  postIds   String[] @default([])
  status    String   @default("proposed") // proposed | ready | sent
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}
